server {
    listen 80;
    server_name api.qknou.kr;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name api.qknou.kr;

    ssl_certificate /etc/letsencrypt/live/www.qknou.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.qknou.kr/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # 시험지 등록(PDF 업로드)이 multer 기준 20MB까지 허용하는데, nginx
    # 기본값(1MB)에 먼저 막혀서 브라우저에 net::ERR_FAILED로 보임.
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
