# ===========================================
# DB 스키마 자동 동기화 (TypeORM synchronize)
# ===========================================
# 기본값 false. 절대 운영 DB를 향한 채로 true로 켜지 마세요 — 엔티티
# 코드에 맞춰 스키마를 자동으로 ALTER/CREATE합니다. 로컬 개발 DB에서
# 빠르게 스키마를 맞춰보고 싶을 때만 임시로 true로 켜세요. 운영/공유
# DB에는 마이그레이션 SQL(migrations/)로만 반영합니다.
# DB_SYNCHRONIZE=true

# ===========================================
# AI 튜터 (Tutor) - LLM 연동
# ===========================================
# 기본은 OpenAI.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
#
# VLLM_URL이 설정되어 있으면 OpenAI 대신 자체 호스팅 vLLM(OpenAI 호환 서버)을 사용함.
# GPT로 되돌리려면 VLLM_URL을 지우면 됨(OPENAI_API_KEY는 그대로 유지).
# VLLM_URL은 반드시 "/v1"까지만 (SDK가 뒤에 /chat/completions 등을 붙임.
# /v1/models처럼 엔드포인트 경로까지 넣으면 안 됨).
# VLLM_URL=http://<vllm-host>:8000/v1
# VLLM_API_KEY=not-needed  # vLLM이 인증을 안 걸면 아무 문자열이나 넣어도 됨(비워두면 SDK가 거부)
# VLLM_MODEL=<vllm에 올린(--served-model-name) 모델 이름>  # 안 채우면 OPENAI_MODEL 값을 그대로 씀

# ===========================================
# Sentry 에러 모니터링
# ===========================================
# Sentry 프로젝트 DSN (없으면 Sentry 비활성화)
# SENTRY_DSN=https://xxx@oxx.ingest.sentry.io/xxx

# ===========================================
# 프론트엔드 리다이렉트 (Google/Kakao 로그인 후)
# ===========================================
# 설정하지 않으면 NODE_ENV 기준으로 자동 설정됩니다.
#   - production → https://www.qknou.kr
#   - 그 외 → http://localhost:3001
#
# 개발 환경 (로컬 프론트 주소에 맞게 설정)
# FRONTEND_URL=http://localhost:3001
#
# 프로덕션 환경
# FRONTEND_URL=https://www.qknou.kr
#
# /auth/google, /auth/kakao 호출 시 ?redirect_uri=<프론트 origin> 을 넘기면
# 로그인 성공 후 FRONTEND_URL 대신 그 주소로 리다이렉트됨 (open redirect 방지를 위해
# 아래 whitelist에 있는 origin만 허용됨. 설정 안 하면 기본값 사용).
#   기본값: http://localhost:3000, http://localhost:3001, https://www.qknou.kr, https://qknou-fe.onrender.com
# ALLOWED_REDIRECT_ORIGINS=http://localhost:3000,https://www.qknou.kr,https://qknou-fe.onrender.com

# ===========================================
# 피드백 → GitHub Issue / Discord 알림 연동
# ===========================================
# 피드백 전용 GitHub 레포 (반드시 Private). Issues: Read and write 권한만
# 가진 fine-grained PAT 사용 권장. 라벨(문항-버그/사이트-버그/기능-제안/기타)은
# 레포에 미리 수동으로 생성해둬야 함 (없으면 이슈 생성 API가 422 에러).
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=

# Discord 채널의 Incoming Webhook URL (봇 토큰 아님)
# DISCORD_WEBHOOK_URL=

# ===========================================
# 관리자 인증
# ===========================================
# 방식 1: 구글/카카오 로그인 이메일이 이 값과 일치하면 관리자로 취급 (AdminGuard)
# ADMIN_EMAIL=

# 방식 2: 아이디/비밀번호 로그인 (POST /api/admin/auth/login).
# 비밀번호는 평문이 아니라 bcrypt 해시로 저장 — 아래처럼 생성:
#   node -e "console.log(require('bcryptjs').hashSync('원하는비밀번호', 10))"
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=
